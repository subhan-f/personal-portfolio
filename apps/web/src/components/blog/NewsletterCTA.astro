---
interface Props {
  href?: string;
}
const { href = '#' } = Astro.props;
---

<aside class="my-12 p-6 sm:p-8 rounded-2xl bg-linear-to-br from-[#1cd8d2]/10 to-[#00bf8f]/10 border border-[#1cd8d2]/20">
  <div class="flex flex-col sm:flex-row sm:items-center gap-4">
    <div class="flex-1">
      <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1">
        Stay in the loop
      </h3>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Articles on web development, AI, and engineering. No spam — unsubscribe any time.
      </p>
    </div>
    <a
      href={href}
      target={href !== '#' ? '_blank' : undefined}
      rel={href !== '#' ? 'noopener noreferrer' : undefined}
      class="flex-shrink-0 inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-[#1cd8d2] text-gray-900 text-sm font-semibold hover:bg-[#00bf8f] transition-colors"
    >
      Subscribe →
    </a>
  </div>
</aside>
