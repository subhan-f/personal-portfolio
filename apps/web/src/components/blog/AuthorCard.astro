---
import { getStrapiMedia } from '@lib/strapi';
import type { StrapiAuthor } from '@lib/strapi';

interface Props {
  author: StrapiAuthor;
}

const { author } = Astro.props;
const avatarUrl = getStrapiMedia(author.avatar?.url);
---

<div class="flex items-center gap-4 p-5 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 mt-10">
  {avatarUrl ? (
    <img
      src={avatarUrl}
      alt={author.name}
      class="w-12 h-12 rounded-full object-cover flex-shrink-0"
      loading="lazy"
    />
  ) : (
    <div class="w-12 h-12 rounded-full bg-[#1cd8d2]/15 flex items-center justify-center text-lg font-bold text-[#1cd8d2] flex-shrink-0">
      {author.name.charAt(0).toUpperCase()}
    </div>
  )}
  <div>
    <p class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wide mb-0.5">Written by</p>
    <p class="font-semibold text-gray-900 dark:text-white text-sm">{author.name}</p>
  </div>
</div>
