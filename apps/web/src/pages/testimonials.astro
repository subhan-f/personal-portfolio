---
import MainLayout from '@layouts/MainLayout.astro';
import { Testimonials } from '@components/sections/Testimonials';
import { fetchStrapi, getStrapiMedia } from '@lib/strapi';
import type { StrapiList, StrapiTestimonial } from '@lib/strapi';

const { data: raw } = await fetchStrapi<StrapiList<StrapiTestimonial>>(
  '/testimonials',
  { 'populate[image]': 'true' }
);

const items = raw.map((t) => ({
  name: t.name,
  role: t.role,
  review: t.review,
  image: getStrapiMedia(t.image?.url),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://subhanfarrakh.com/#person',
  name: 'Subhan Farrakh',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: String(items.length),
    bestRating: '5',
    worstRating: '1',
  },
  review: items.map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.name },
    reviewBody: t.review,
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    publisher: { '@type': 'Organization', name: t.role },
  })),
};
---

<MainLayout title="Testimonials | Subhan Farrakh" description="What clients and colleagues say about working with Subhan Farrakh.">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <h1 class="sr-only">Client Testimonials</h1>
  <Testimonials items={items} client:visible />
</MainLayout>
