---
import BlogLayout from '@layouts/BlogLayout.astro';
import { fetchStrapi, getStrapiMedia } from '@lib/strapi';
import { calcReadingTime } from '@lib/markdown';
import type { StrapiList, StrapiArticle } from '@lib/strapi';

export async function getStaticPaths() {
  const { data: posts } = await fetchStrapi<StrapiList<StrapiArticle>>(
    '/articles',
    {
      'populate[cover]': 'true',
      'populate[category]': 'true',
      'populate[blocks][populate]': '*',
      'sort': 'publishedAt:desc',
    }
  );

  const tagMap = new Map<string, { label: string; posts: StrapiArticle[] }>();
  for (const post of posts) {
    const tags = post.tags ?? (post.category ? [post.category.name] : []);
    for (const tag of tags) {
      const key = tag.toLowerCase().replace(/[\s/]+/g, '-');
      if (!tagMap.has(key)) tagMap.set(key, { label: tag, posts: [] });
      tagMap.get(key)!.posts.push(post);
    }
  }

  return [...tagMap.entries()].map(([key, { label, posts: tagPosts }]) => ({
    params: { tag: key },
    props: { tagLabel: label, tagKey: key, posts: tagPosts },
  }));
}

const { tagLabel, tagKey, posts } = Astro.props as {
  tagLabel: string;
  tagKey: string;
  posts: StrapiArticle[];
};
---

<BlogLayout
  title={`#${tagLabel} — Blog`}
  description={`${posts.length} article${posts.length === 1 ? '' : 's'} tagged with ${tagLabel}.`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">

    <!-- Header -->
    <div class="mb-10">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white mb-6 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        All posts
      </a>
      <div class="flex items-center gap-3 mb-2">
        <span class="px-3 py-1 rounded-full text-sm font-semibold bg-gray-900 dark:bg-white text-white dark:text-gray-900">
          #{tagLabel}
        </span>
      </div>
      <p class="text-gray-500 dark:text-gray-400 text-sm">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => {
        const tags = post.tags ?? (post.category ? [post.category.name] : []);
        const coverUrl = getStrapiMedia(post.cover?.url);
        const readingTime = calcReadingTime(post.blocks);
        return (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden hover:border-[#1cd8d2]/60 hover:shadow-lg transition-all duration-200 hover:-translate-y-0.5"
          >
            {coverUrl ? (
              <div class="aspect-video overflow-hidden bg-gray-100 dark:bg-gray-800">
                <img src={coverUrl} alt={post.cover?.alternativeText ?? post.title} class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy" />
              </div>
            ) : (
              <div class="aspect-video bg-linear-to-br from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900 flex items-center justify-center">
                <span class="text-3xl font-bold text-gray-300 dark:text-gray-600">{post.title.charAt(0)}</span>
              </div>
            )}
            <div class="flex flex-col flex-1 p-5">
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {tags.slice(0, 3).map((tag: string) => (
                    <span class:list={[
                      'text-xs px-2 py-0.5 rounded-full font-medium',
                      tag.toLowerCase().replace(/[\s/]+/g, '-') === tagKey
                        ? 'bg-[#1cd8d2]/15 text-[#1cd8d2]'
                        : 'bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400',
                    ]}>
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2 leading-snug group-hover:text-[#1cd8d2] transition-colors line-clamp-2">{post.title}</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2 mb-4 flex-1">{post.description}</p>
              <div class="flex items-center justify-between text-xs text-gray-400 dark:text-gray-500">
                <time datetime={post.publishedAt}>
                  {new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span>{readingTime} min read</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

  </div>
</BlogLayout>
