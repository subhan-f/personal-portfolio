---
import BlogLayout from '@layouts/BlogLayout.astro';
import { fetchStrapi, getStrapiMedia } from '@lib/strapi';
import { calcReadingTime } from '@lib/markdown';
import type { StrapiList, StrapiArticle } from '@lib/strapi';

const PAGE_SIZE = 6;

export async function getStaticPaths() {
  const { data: posts } = await fetchStrapi<StrapiList<StrapiArticle>>(
    '/articles',
    {
      'populate[cover]': 'true',
      'populate[category]': 'true',
      'populate[blocks][populate]': '*',
      'sort': 'publishedAt:desc',
    }
  );

  const total = posts.length;
  const pageCount = Math.ceil(total / PAGE_SIZE);

  return Array.from({ length: pageCount }, (_, i) => ({
    params: { page: String(i + 1) },
    props: {
      posts: posts.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
      currentPage: i + 1,
      lastPage: pageCount,
      total,
    },
  }));
}

const { posts, currentPage, lastPage, total } = Astro.props as {
  posts: StrapiArticle[];
  currentPage: number;
  lastPage: number;
  total: number;
};

// Page 1 should always be /blog — redirect
if (currentPage === 1) {
  return Astro.redirect('/blog', 301);
}
---

<BlogLayout
  title={`Blog — Page ${currentPage}`}
  description={`Page ${currentPage} of ${lastPage} — articles on web development, AI, and engineering.`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-20">

    <!-- Header -->
    <div class="mb-10 flex items-end justify-between">
      <div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">Blog</h1>
        <p class="text-sm text-gray-400 dark:text-gray-500">
          Page {currentPage} of {lastPage} · {total} posts
        </p>
      </div>
      <a href="/blog" class="text-sm text-[#1cd8d2] hover:underline">← Back to all</a>
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {posts.map((post) => {
        const tags = post.tags ?? (post.category ? [post.category.name] : []);
        const coverUrl = getStrapiMedia(post.cover?.url);
        const readingTime = calcReadingTime(post.blocks);
        return (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden hover:border-[#1cd8d2]/60 hover:shadow-lg transition-all duration-200 hover:-translate-y-0.5"
          >
            {coverUrl ? (
              <div class="aspect-video overflow-hidden bg-gray-100 dark:bg-gray-800">
                <img src={coverUrl} alt={post.cover?.alternativeText ?? post.title} class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy" />
              </div>
            ) : (
              <div class="aspect-video bg-linear-to-br from-gray-100 to-gray-200 dark:from-gray-800 dark:to-gray-900 flex items-center justify-center">
                <span class="text-3xl font-bold text-gray-300 dark:text-gray-600">{post.title.charAt(0)}</span>
              </div>
            )}
            <div class="flex flex-col flex-1 p-5">
              {tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {tags.slice(0, 3).map((tag: string) => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 font-medium">{tag}</span>
                  ))}
                </div>
              )}
              <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-2 leading-snug group-hover:text-[#1cd8d2] transition-colors line-clamp-2">{post.title}</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2 mb-4 flex-1">{post.description}</p>
              <div class="flex items-center justify-between text-xs text-gray-400 dark:text-gray-500">
                <time datetime={post.publishedAt}>
                  {new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span>{readingTime} min read</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Pagination nav -->
    <nav class="flex items-center justify-center gap-2" aria-label="Pagination">
      {currentPage > 1 ? (
        <a
          href={currentPage === 2 ? '/blog' : `/blog/page/${currentPage - 1}`}
          class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
        >
          ← Previous
        </a>
      ) : (
        <span class="px-4 py-2 rounded-lg text-sm font-medium text-gray-300 dark:text-gray-600 cursor-not-allowed">← Previous</span>
      )}

      <div class="flex items-center gap-1">
        {Array.from({ length: lastPage }, (_, i) => i + 1).map((n) => (
          <a
            href={n === 1 ? '/blog' : `/blog/page/${n}`}
            class:list={[
              'w-9 h-9 flex items-center justify-center rounded-lg text-sm font-medium transition-colors',
              n === currentPage
                ? 'bg-gray-900 dark:bg-white text-white dark:text-gray-900'
                : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700',
            ]}
          >
            {n}
          </a>
        ))}
      </div>

      {currentPage < lastPage ? (
        <a
          href={`/blog/page/${currentPage + 1}`}
          class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
        >
          Next →
        </a>
      ) : (
        <span class="px-4 py-2 rounded-lg text-sm font-medium text-gray-300 dark:text-gray-600 cursor-not-allowed">Next →</span>
      )}
    </nav>

  </div>
</BlogLayout>
