---
import BlogLayout from '@layouts/BlogLayout.astro';
import { fetchStrapi, getArticleTags, getStrapiMedia, tagToSlug } from '@lib/strapi';
import { calcReadingTime } from '@lib/markdown';
import type { StrapiList, StrapiArticle } from '@lib/strapi';

const { data: posts } = await fetchStrapi<StrapiList<StrapiArticle>>(
  '/articles',
  {
    'populate[cover]': 'true',
    'populate[category]': 'true',
    'populate[blocks][populate]': '*',
    'sort': 'publishedAt:desc',
  }
);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
}

function coverUrl(post: StrapiArticle): string | null {
  if (!post.cover?.url) return null;
  return getStrapiMedia(post.cover.url);
}

const featured = posts[0];
const rest = posts.slice(1);
---

<BlogLayout
  title="Blog"
  description="Building on the web. Writing about what I learn along the way."
>

  <!-- ── Hero (unchanged) ──────────────────────────────────────────────────── -->
  <section class="hero-section">
    <div class="glow-wrap" aria-hidden="true">
      <div class="glow glow-a"></div>
      <div class="glow glow-b"></div>
    </div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-28 pb-20 relative">
      <p class="eyebrow">Subhan Farrakh</p>
      <h1 class="hero-heading">
        Building on the web.<br />
        Writing about what I learn.
      </h1>
      <p class="hero-sub">
        Full-stack engineer. I write about Astro, React, AI, and the craft of
        shipping modern products that actually work.
      </p>
      <div class="scroll-hint" aria-hidden="true"><span>↓</span></div>
    </div>
  </section>

  <!-- ── Posts ─────────────────────────────────────────────────────────────── -->
  <div class="posts-outer">

    <div class="posts-header">
      <span class="posts-label">Writing</span>
      <span class="posts-count">{posts.length} posts</span>
    </div>

    {featured && (
      <>
        <!-- ── Featured post ─────────────────────────────────────────────── -->
        <article class="featured-card">
          <div class="featured-img-wrap">
            {coverUrl(featured)
              ? <img src={coverUrl(featured)!} alt={featured.cover?.alternativeText ?? featured.title} class="card-img" loading="eager" decoding="async" />
              : <div class="img-placeholder" aria-hidden="true"></div>
            }
          </div>
          <div class="featured-text">
            <div class="card-eyebrow">
              <span class="badge-latest">Latest</span>
              <div class="tag-row">
                {getArticleTags(featured).slice(0, 3).map(tag => (
                  <a href={`${import.meta.env.BASE_URL}tag/${tagToSlug(tag)}`} class="tag">{tag}</a>
                ))}
              </div>
            </div>
            <h2 class="featured-title">
              <a href={`${import.meta.env.BASE_URL}${featured.slug}`} class="card-link">{featured.title}</a>
            </h2>
            {featured.description && <p class="featured-desc">{featured.description}</p>}
            <div class="featured-footer">
              <span class="meta-line">
                <time datetime={featured.publishedAt}>{formatDate(featured.publishedAt)}</time>
                <span aria-hidden="true">·</span>
                <span>{calcReadingTime(featured.blocks)} min read</span>
              </span>
            </div>
          </div>
        </article>

        <!-- ── Post list ──────────────────────────────────────────────────── -->
        {rest.length > 0 && (
          <ul class="post-list">
            {rest.map((post) => {
              const img = coverUrl(post);
              const tags = getArticleTags(post);
              return (
                <li class="post-item">
                  <div class="post-thumb-wrap">
                    {img
                      ? <img src={img} alt={post.cover?.alternativeText ?? post.title} class="card-img" loading="lazy" decoding="async" />
                      : <div class="img-placeholder" aria-hidden="true"></div>
                    }
                  </div>
                  <div class="post-text">
                    <h3 class="post-title">
                      <a href={`${import.meta.env.BASE_URL}${post.slug}`} class="card-link">{post.title}</a>
                    </h3>
                    {post.description && <p class="post-desc">{post.description}</p>}
                    <div class="post-bottom">
                      <span class="meta-line">
                        <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                        <span aria-hidden="true">·</span>
                        <span>{calcReadingTime(post.blocks)} min read</span>
                      </span>
                      {tags.length > 0 && (
                        <div class="tag-row">
                          {tags.slice(0, 2).map(tag => (
                            <a href={`${import.meta.env.BASE_URL}tag/${tagToSlug(tag)}`} class="tag">{tag}</a>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </>
    )}
  </div>

</BlogLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────────────── */
  .hero-section {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border-subtle);
  }
  .glow-wrap {
    position: absolute; inset: 0;
    pointer-events: none; overflow: hidden;
  }
  .glow {
    position: absolute; border-radius: 50%;
    filter: blur(80px); opacity: 0.18;
  }
  .glow-a {
    width: 480px; height: 320px; top: -80px; left: 50%;
    transform: translateX(-60%);
    background: radial-gradient(ellipse at center, oklch(0.790 0.137 193.8) 0%, transparent 70%);
    animation: drift-a 12s ease-in-out infinite;
  }
  .glow-b {
    width: 360px; height: 280px; top: 20px; left: 50%;
    transform: translateX(10%);
    background: radial-gradient(ellipse at center, oklch(0.710 0.152 171.4) 0%, transparent 70%);
    animation: drift-b 16s ease-in-out infinite;
  }
  @keyframes drift-a {
    0%, 100% { opacity: 0.18; transform: translateX(-60%) scale(1); }
    50%       { opacity: 0.26; transform: translateX(-55%) scale(1.08); }
  }
  @keyframes drift-b {
    0%, 100% { opacity: 0.12; transform: translateX(10%) scale(1); }
    50%       { opacity: 0.20; transform: translateX(14%) scale(1.1); }
  }
  @media (prefers-reduced-motion: reduce) { .glow { animation: none !important; } }

  .eyebrow {
    font-size: 0.8125rem; font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--brand); margin-bottom: 1.25rem;
  }
  .hero-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -0.02em; color: var(--text-1);
    margin-bottom: 1.25rem; max-width: 22ch;
  }
  .hero-sub {
    font-size: 1rem; line-height: 1.7;
    color: var(--text-2); max-width: 52ch;
  }
  .scroll-hint {
    margin-top: 3rem; color: var(--text-3); font-size: 1rem;
    animation: bob 2.5s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50%       { transform: translateY(4px); opacity: 0.8; }
  }

  /* ── Posts outer ─────────────────────────────────────────────────────────── */
  .posts-outer {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }
  .posts-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 2rem;
  }
  .posts-label {
    font-size: 0.75rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-3);
  }
  .posts-count { font-size: 0.75rem; color: var(--text-3); }

  /* ── Cover-link pattern ──────────────────────────────────────────────────── */
  /* The title <a> gets a ::after that covers the whole card.
     Tags sit above it via z-index so they stay independently clickable. */
  .card-link {
    text-decoration: none;
    color: inherit;
    outline: none;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }
  .tag, .meta-line { position: relative; z-index: 1; }

  /* ── Shared image ────────────────────────────────────────────────────────── */
  .card-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .img-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(
      135deg,
      oklch(0.790 0.137 193.8 / 0.12) 0%,
      oklch(0.710 0.152 171.4 / 0.07) 100%
    );
  }

  /* ── Shared tags ─────────────────────────────────────────────────────────── */
  .tag-row { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tag {
    font-size: 0.6875rem; font-weight: 500;
    padding: 0.25em 0.65em; border-radius: 9999px;
    background: oklch(0.790 0.137 193.8 / 0.10);
    color: var(--brand);
    border: 1px solid oklch(0.790 0.137 193.8 / 0.22);
    text-decoration: none; white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
    cursor: pointer;
  }
  .tag:hover {
    background: oklch(0.790 0.137 193.8 / 0.18);
    border-color: oklch(0.790 0.137 193.8 / 0.4);
  }

  /* ── Shared meta line ────────────────────────────────────────────────────── */
  .meta-line {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.8rem; color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  /* ── Featured card ───────────────────────────────────────────────────────── */
  .featured-card {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 1.75rem;
    padding: 1.375rem;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1.25rem;
    margin-bottom: 0.75rem;
    transition: border-color 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }
  .featured-card:has(.card-link:hover) {
    border-color: oklch(0.790 0.137 193.8 / 0.45);
    box-shadow:
      0 0 0 1px oklch(0.790 0.137 193.8 / 0.07),
      0 8px 32px oklch(0.790 0.137 193.8 / 0.10);
  }
  .featured-card:has(.card-link:hover) .card-img { transform: scale(1.03); }
  .featured-card:has(.card-link:hover) .featured-title { color: var(--brand); }

  .featured-img-wrap {
    width: 240px;
    min-height: 180px;
    flex-shrink: 0;
    border-radius: 0.625rem;
    overflow: hidden;
    background: var(--surface-raised);
  }

  .featured-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.125rem 0;
  }

  .card-eyebrow {
    display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
  }

  .badge-latest {
    font-size: 0.6rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.07em;
    padding: 0.22em 0.65em; border-radius: 9999px;
    background: oklch(0.790 0.137 193.8 / 0.12);
    color: var(--brand);
    border: 1px solid oklch(0.790 0.137 193.8 / 0.28);
    white-space: nowrap;
    position: relative; z-index: 1;
  }

  .featured-title {
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    font-weight: 700; line-height: 1.25;
    letter-spacing: -0.02em; color: var(--text-1);
    margin: 0; transition: color 0.15s;
  }

  .featured-desc {
    font-size: 0.9375rem; line-height: 1.65;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .featured-footer {
    display: flex; align-items: center;
    gap: 0.75rem; flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  /* ── Post list ───────────────────────────────────────────────────────────── */
  .post-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column;
  }

  .post-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.125rem;
    padding: 1.25rem 0.625rem;
    margin: 0 -0.625rem;
    border-bottom: 1px solid var(--border-subtle);
    border-radius: 0.625rem;
    transition: background 0.15s;
    overflow: hidden;
  }
  .post-item:first-child { border-top: 1px solid var(--border-subtle); }
  .post-item:has(.card-link:hover) { background: var(--surface); }
  .post-item:has(.card-link:hover) .card-img { transform: scale(1.05); }
  .post-item:has(.card-link:hover) .post-title { color: var(--brand); }

  .post-thumb-wrap {
    width: 120px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--surface-raised);
  }

  .post-text {
    flex: 1; min-width: 0;
    display: flex; flex-direction: column; gap: 0.35rem;
  }

  .post-title {
    font-size: 1rem; font-weight: 600;
    color: var(--text-1); line-height: 1.4;
    margin: 0; transition: color 0.15s;
  }

  .post-desc {
    font-size: 0.84375rem; line-height: 1.6;
    color: var(--text-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-bottom {
    display: flex; align-items: center;
    gap: 0.75rem; flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  /* ── Mobile ──────────────────────────────────────────────────────────────── */
  @media (max-width: 580px) {
    .featured-card { flex-direction: column; gap: 1rem; }
    .featured-img-wrap { width: 100%; min-height: 160px; }
  }
  @media (max-width: 400px) {
    .post-thumb-wrap { width: 90px; height: 60px; }
  }
</style>
