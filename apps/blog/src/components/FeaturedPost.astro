---
import type { StrapiArticle } from '@lib/strapi';
import { getStrapiMedia, getArticleTags } from '@lib/strapi';
import { calcReadingTime } from '@lib/markdown';

const { post } = Astro.props as { post: StrapiArticle };
const tags = getArticleTags(post);
const coverUrl = getStrapiMedia(post.cover?.url);
const readingTime = calcReadingTime(post.blocks);
const pubDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
---

<a
  href={`/${post.slug}`}
  class="featured-card group block rounded-2xl overflow-hidden mb-10 transition-all duration-300"
  style="background: var(--surface); border: 1px solid var(--border);"
>
  <div class="lg:flex">
    <!-- Image -->
    <div
      class="relative lg:w-[52%] aspect-video lg:aspect-auto overflow-hidden"
      style="background: var(--surface-raised); min-height: 240px;"
    >
      {coverUrl ? (
        <img
          src={coverUrl}
          alt={post.cover?.alternativeText ?? post.title}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          loading="eager"
        />
      ) : (
        <div
          class="w-full h-full flex items-center justify-center"
          style="background: linear-gradient(135deg, oklch(0.790 0.137 193.8 / 0.12) 0%, oklch(0.710 0.152 171.4 / 0.12) 100%);"
        >
          <span class="text-7xl font-bold" style="color: oklch(0.790 0.137 193.8 / 0.25);">
            {post.title.charAt(0)}
          </span>
        </div>
      )}

      <!-- Gradient overlay on image (desktop) -->
      <div
        class="absolute inset-0 pointer-events-none hidden lg:block"
        style="background: linear-gradient(to right, transparent 60%, var(--surface) 100%);"
      />
    </div>

    <!-- Content -->
    <div class="lg:w-[48%] p-6 sm:p-8 lg:p-10 flex flex-col justify-center">
      <!-- Featured badge + tags -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span
          class="text-[11px] px-2.5 py-1 rounded-full font-semibold"
          style="background: oklch(0.790 0.137 193.8 / 0.12); color: var(--brand); border: 1px solid oklch(0.790 0.137 193.8 / 0.25);"
        >
          Featured
        </span>
        {tags.slice(0, 2).map((tag) => (
          <span
            class="text-[11px] px-2 py-0.5 rounded-full font-medium"
            style="background: var(--surface-raised); color: var(--text-3); border: 1px solid var(--border-subtle);"
          >
            {tag}
          </span>
        ))}
      </div>

      <!-- Title with gradient effect -->
      <h2 class="text-2xl sm:text-3xl font-bold leading-tight mb-3">
        <span class="gradient-text">{post.title}</span>
      </h2>

      <p class="text-sm mb-6 line-clamp-3" style="color: var(--text-2);">{post.description}</p>

      <div class="flex items-center justify-between text-xs" style="color: var(--text-3);">
        <time datetime={post.publishedAt}>{pubDate}</time>
        <span class="flex items-center gap-3">
          <span>{readingTime} min read</span>
          <span
            class="font-semibold transition-colors duration-150"
            style="color: var(--brand);"
          >
            Read →
          </span>
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  .featured-card:hover {
    border-color: oklch(0.790 0.137 193.8 / 0.5) !important;
    box-shadow: 0 16px 60px var(--shadow-color), 0 0 0 1px oklch(0.790 0.137 193.8 / 0.1);
  }
</style>
