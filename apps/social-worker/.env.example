# ── Queue ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────
PORT=3100
# Optional: verify Strapi webhook signature
WEBHOOK_SECRET=

# ── Blog ──────────────────────────────────────────────────────
BLOG_BASE_URL=https://blog.subhanfarrakh.com

# ── Active platforms (comma-separated) ────────────────────────
# Start with bluesky and hashnode (no approval needed), add others once approved
ACTIVE_PLATFORMS=bluesky,hashnode

# ── LinkedIn ──────────────────────────────────────────────────
# Get from: https://www.linkedin.com/developers/apps
# Requires w_member_social scope + app review
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXXX

# ── Twitter / X ───────────────────────────────────────────────
# Get from: https://developer.x.com/en/portal/dashboard
# Free tier: 1500 tweets/month write access
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Bluesky ───────────────────────────────────────────────────
# No approval needed — just your handle + an App Password
# App passwords: https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=subhanfarrakh.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Reddit ────────────────────────────────────────────────────
# Register at: https://www.reddit.com/prefs/apps (script app type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=webdev

# ── Hashnode ──────────────────────────────────────────────────
# API key: https://hashnode.com/settings/developer
# Publication ID: from your Hashnode dashboard URL
HASHNODE_API_KEY=
HASHNODE_PUBLICATION_ID=
