# ── Queue ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────────
PORT=3100

# Strapi webhook secret — set in Strapi: Settings → Webhooks → Secret
# Used to verify the X-Strapi-Signature header (HMAC-SHA256).
WEBHOOK_SECRET=

# ── Vercel deploy webhook ─────────────────────────────────────
# Secret set in Vercel: Project → Settings → Webhooks → add webhook
#   URL:    https://your-worker.railway.app/webhook/vercel-deploy
#   Events: deployment.succeeded
# Vercel signs requests with HMAC-SHA1 of the raw body.
VERCEL_WEBHOOK_SECRET=

# Restrict promotion to this project only (the blog). Defaults to the
# blog project ID already in config.ts. Override here if it changes.
VERCEL_BLOG_PROJECT_ID=prj_W9LIKPIG3iZCcB3wTHduBKjVz2qQ

# ── Blog ──────────────────────────────────────────────────────
BLOG_BASE_URL=https://blog.subhanfarrakh.com

# Safety-net delay (ms) for parked fanout jobs. If the Vercel deploy
# webhook never arrives, the job runs after this delay. Default: 24h.
# Set lower (e.g. 600000 = 10 min) if you want a tighter fallback.
PARK_DELAY_MS=86400000

# ── Active platforms (comma-separated) ────────────────────────
# Start with the two that need no API approval, then add others.
ACTIVE_PLATFORMS=bluesky,hashnode

# ── LinkedIn ──────────────────────────────────────────────────
# Requires w_member_social scope + LinkedIn app review.
# Get from: https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXXX

# ── Twitter / X ───────────────────────────────────────────────
# Free tier: 1,500 writes/month. Get from: https://developer.x.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Bluesky ───────────────────────────────────────────────────
# No approval needed. Create an App Password at:
# https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=subhanfarrakh.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Reddit ────────────────────────────────────────────────────
# Register a "script" app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=webdev

# ── Hashnode ──────────────────────────────────────────────────
# API key: https://hashnode.com/settings/developer
# Publication ID: from your Hashnode dashboard URL
HASHNODE_API_KEY=
HASHNODE_PUBLICATION_ID=
